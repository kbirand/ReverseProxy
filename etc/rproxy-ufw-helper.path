[Unit]
Description=Watch for an rproxy ufw firewall request

[Path]
# The UI writes this file (it has ReadWritePaths=/var/lib/rproxy) to ask the
# privileged helper to run a ufw operation. Content is JSON; see ufw-helper.sh.
PathExists=/var/lib/rproxy/.ufw-action
Unit=rproxy-ufw-helper.service

[Install]
WantedBy=multi-user.target
